<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ 的备份/迁移规则：密码箱密文与经期记录不参与云备份，
  也不参与换机迁移。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="vault.dat" />
        <exclude domain="sharedpref" path="period_records.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="vault.dat" />
        <exclude domain="sharedpref" path="period_records.xml" />
    </device-transfer>
</data-extraction-rules>
